PORT=5000
NODE_ENV=development

# PostgreSQL Database (Neon Serverless or local PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/sentinai?sslmode=require"
DIRECT_URL="postgresql://user:password@localhost:5432/sentinai?sslmode=require"

# Google Gemini API Configuration
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-3.5-flash-lite"
AI_TIMEOUT_MS=3500

# Optional SMTP Configuration (uses Ethereal preview inbox if omitted)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
ALERT_RECEIVER_EMAIL="sre-alerts@careguide.local"
