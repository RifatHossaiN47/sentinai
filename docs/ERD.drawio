        <mxCell id="entity_telemetry" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;spacingRight=14;arcSize=6;shadow=1;" value="&lt;div style=&#39;border-bottom: 2px solid #B45309; padding-bottom: 8px; margin-bottom: 10px;&#39;&gt;&lt;span style=&#39;font-size: 16px; font-weight: 800; color: #78350F;&#39;&gt;TelemetryLog&lt;/span&gt; &amp;nbsp;&lt;span style=&#39;background-color: #FEF3C7; color: #92400E; font-size: 11.5px; padding: 2px 7px; border-radius: 4px; font-weight: bold;&#39;&gt;Time-Series Stream&lt;/span&gt;&lt;/div&gt;&lt;div style=&#39;font-family: Inter, sans-serif; font-size: 13px; line-height: 1.85;&#39;&gt;&lt;span style=&#39;background-color: #FEF3C7; color: #92400E; font-size: 11px; font-weight: 800; padding: 1px 5px; border-radius: 3px;&#39;&gt;PK&lt;/span&gt; &amp;nbsp;&lt;b style=&#39;color: #78350F;&#39;&gt;id&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;String (UUID)&lt;/span&gt;&lt;br/&gt;&lt;span style=&#39;background-color: #FFEDD5; color: #C2410C; font-size: 11px; font-weight: 800; padding: 1px 5px; border-radius: 3px;&#39;&gt;FK&lt;/span&gt; &amp;nbsp;&lt;b style=&#39;color: #0F172A;&#39;&gt;endpoint_id&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;String (FK → ApiEndpoint)&lt;/span&gt;&lt;br/&gt;&lt;span style=&#39;background-color: #D1FAE5; color: #047857; font-size: 11px; font-weight: 800; padding: 1px 5px; border-radius: 3px;&#39;&gt;IDX&lt;/span&gt; &lt;b style=&#39;color: #0F172A;&#39;&gt;api_name&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;String (Indexed metric)&lt;/span&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b style=&#39;color: #0F172A;&#39;&gt;response_time_ms&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;Int (e.g. 1200, 5500)&lt;/span&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b style=&#39;color: #0F172A;&#39;&gt;status_code&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;Int (e.g. 200, 500, 404)&lt;/span&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b style=&#39;color: #0F172A;&#39;&gt;records_returned&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;Int (e.g. 50, 0)&lt;/span&gt;&lt;br/&gt;&lt;span style=&#39;background-color: #D1FAE5; color: #047857; font-size: 11px; font-weight: 800; padding: 1px 5px; border-radius: 3px;&#39;&gt;IDX&lt;/span&gt; &lt;b style=&#39;color: #0F172A;&#39;&gt;is_anomaly&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;Boolean (default: false)&lt;/span&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b style=&#39;color: #0F172A;&#39;&gt;anomaly_reason&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;String? (&amp;quot;HTTP_500&amp;quot;)&lt;/span&gt;&lt;br/&gt;&lt;span style=&#39;background-color: #D1FAE5; color: #047857; font-size: 11px; font-weight: 800; padding: 1px 5px; border-radius: 3px;&#39;&gt;IDX&lt;/span&gt; &lt;b style=&#39;color: #0F172A;&#39;&gt;timestamp&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;DateTime (default: now)&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="330" width="365" x="450" y="128" as="geometry" />
        </mxCell>
        <mxCell id="card_indexing" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;spacingRight=14;arcSize=8;shadow=1;" value="&lt;b style=&#39;font-size: 14.5px; color: #78350F;&#39;&gt;High-Throughput Indexing &amp;amp; Performance&lt;/b&gt;&lt;br/&gt;&lt;div style=&#39;font-size: 12px; color: #451A03; line-height: 1.55; margin-top: 8px;&#39;&gt;• &lt;b&gt;TelemetryLog Composite Index:&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;code style=&#39;background-color: #FEF3C7; font-weight: bold;&#39;&gt;@@index([api_name, timestamp DESC])&lt;/code&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;Enables sub-10ms retrieval for historical metrics &amp;amp; SLA.&lt;br/&gt;• &lt;b&gt;AnomalyAlert Composite Index:&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&lt;code style=&#39;background-color: #FEF3C7; font-weight: bold;&#39;&gt;@@index([status, severity])&lt;/code&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;Powers instant queries for active dashboard feeds.&lt;br/&gt;• &lt;b&gt;Fast-Path Bypass:&lt;/b&gt; 95%+ healthy checks bypass Gemini LLM, saving free-tier tokens and keeping latency &amp;lt; 30ms.&lt;/div&gt;" vertex="1">
          <mxGeometry height="330" width="365" x="450" y="482" as="geometry" />
        </mxCell>
        <mxCell id="entity_alert" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4338CA;strokeWidth=2.5;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;spacingRight=14;arcSize=6;shadow=1;" value="&lt;div style=&#39;border-bottom: 2px solid #4338CA; padding-bottom: 8px; margin-bottom: 10px;&#39;&gt;&lt;span style=&#39;font-size: 16px; font-weight: 800; color: #312E81;&#39;&gt;AnomalyAlert&lt;/span&gt; &amp;nbsp;&lt;span style=&#39;background-color: #EEF2FF; color: #4338CA; font-size: 11.5px; padding: 2px 7px; border-radius: 4px; font-weight: bold;&#39;&gt;AI Incident Triage&lt;/span&gt;&lt;/div&gt;&lt;div style=&#39;font-family: Inter, sans-serif; font-size: 13px; line-height: 1.8;&#39;&gt;&lt;span style=&#39;background-color: #FEF3C7; color: #92400E; font-size: 11px; font-weight: 800; padding: 1px 5px; border-radius: 3px;&#39;&gt;PK&lt;/span&gt; &amp;nbsp;&lt;b style=&#39;color: #312E81;&#39;&gt;id&lt;/b&gt; : &lt;span style=&#39;color: #4338CA;&#39;&gt;String (UUID)&lt;/span&gt;&lt;br/&gt;&lt;span style=&#39;background-color: #FFEDD5; color: #C2410C; font-size: 11px; font-weight: 800; padding: 1px 5px; border-radius: 3px;&#39;&gt;FK&lt;/span&gt; &amp;nbsp;&lt;b style=&#39;color: #0F172A;&#39;&gt;endpoint_id&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;String? (FK → ApiEndpoint)&lt;/span&gt;&lt;br/&gt;&lt;span style=&#39;background-color: #FFEDD5; color: #C2410C; font-size: 11px; font-weight: 800; padding: 1px 5px; border-radius: 3px;&#39;&gt;FK&lt;/span&gt; &amp;nbsp;&lt;b style=&#39;color: #0F172A;&#39;&gt;telemetry_id&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;String? (FK → TelemetryLog)&lt;/span&gt;&lt;br/&gt;&lt;span style=&#39;background-color: #D1FAE5; color: #047857; font-size: 11px; font-weight: 800; padding: 1px 5px; border-radius: 3px;&#39;&gt;IDX&lt;/span&gt; &lt;b style=&#39;color: #0F172A;&#39;&gt;api_name&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;String (&amp;quot;AppointmentAPI&amp;quot;)&lt;/span&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b style=&#39;color: #0F172A;&#39;&gt;status_code&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;Int (Failing status e.g. 500)&lt;/span&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b style=&#39;color: #0F172A;&#39;&gt;response_time_ms&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;Int (Failing latency e.g. 5500)&lt;/span&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b style=&#39;color: #0F172A;&#39;&gt;records_returned&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;Int (Payload count e.g. 0)&lt;/span&gt;&lt;br/&gt;&lt;span style=&#39;background-color: #FEE2E2; color: #991B1B; font-size: 11px; font-weight: 800; padding: 1px 5px; border-radius: 3px;&#39;&gt;IDX&lt;/span&gt; &lt;b style=&#39;color: #DC2626;&#39;&gt;severity&lt;/b&gt; : &lt;span style=&#39;color: #DC2626;&#39;&gt;Enum (CRITICAL, HIGH, WARN)&lt;/span&gt;&lt;br/&gt;&lt;span style=&#39;background-color: #D1FAE5; color: #047857; font-size: 11px; font-weight: 800; padding: 1px 5px; border-radius: 3px;&#39;&gt;IDX&lt;/span&gt; &lt;b style=&#39;color: #059669;&#39;&gt;status&lt;/b&gt; : &lt;span style=&#39;color: #059669;&#39;&gt;Enum (ACTIVE, RESOLVED)&lt;/span&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b style=&#39;color: #0F172A;&#39;&gt;root_cause_explanation&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;Text (AI Gemini Diagnosis)&lt;/span&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b style=&#39;color: #0F172A;&#39;&gt;suggested_action&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;Text (AI SRE Mitigation Steps)&lt;/span&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b style=&#39;color: #0F172A;&#39;&gt;email_dispatched&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;Boolean (Bonus 7.4 tracking)&lt;/span&gt;&lt;br/&gt;&lt;span style=&#39;background-color: #D1FAE5; color: #047857; font-size: 11px; font-weight: 800; padding: 1px 5px; border-radius: 3px;&#39;&gt;IDX&lt;/span&gt; &lt;b style=&#39;color: #0F172A;&#39;&gt;detected_at&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;DateTime (default: now)&lt;/span&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b style=&#39;color: #0F172A;&#39;&gt;resolved_at&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;DateTime? (null until resolved)&lt;/span&gt;&lt;/div&gt;" vertex="1">
