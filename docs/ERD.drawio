        <mxCell id="entity_endpoint" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;spacingRight=14;arcSize=6;shadow=1;" value="&lt;div style=&#39;border-bottom: 2px solid #0F172A; padding-bottom: 8px; margin-bottom: 10px;&#39;&gt;&lt;span style=&#39;font-size: 16px; font-weight: 800; color: #0F172A;&#39;&gt;ApiEndpoint&lt;/span&gt; &amp;nbsp;&lt;span style=&#39;background-color: #F1F5F9; color: #475569; font-size: 11.5px; padding: 2px 7px; border-radius: 4px; font-weight: bold;&#39;&gt;Service Registry&lt;/span&gt;&lt;/div&gt;&lt;div style=&#39;font-family: Inter, sans-serif; font-size: 13px; line-height: 1.85;&#39;&gt;&lt;span style=&#39;background-color: #FEF3C7; color: #92400E; font-size: 11px; font-weight: 800; padding: 1px 5px; border-radius: 3px;&#39;&gt;PK&lt;/span&gt; &amp;nbsp;&lt;b style=&#39;color: #0F172A;&#39;&gt;id&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;String (UUID)&lt;/span&gt;&lt;br/&gt;&lt;span style=&#39;background-color: #DBEAFE; color: #1E40AF; font-size: 11px; font-weight: 800; padding: 1px 5px; border-radius: 3px;&#39;&gt;UQ&lt;/span&gt; &amp;nbsp;&lt;b style=&#39;color: #0F172A;&#39;&gt;name&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;String (&amp;quot;PatientDataAPI&amp;quot;)&lt;/span&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b style=&#39;color: #0F172A;&#39;&gt;description&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;String?&lt;/span&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b style=&#39;color: #0F172A;&#39;&gt;target_url&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;String?&lt;/span&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b style=&#39;color: #0F172A;&#39;&gt;is_critical&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;Boolean (default: true)&lt;/span&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b style=&#39;color: #0F172A;&#39;&gt;sla_latency_ms&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;Int (default: 2500)&lt;/span&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b style=&#39;color: #0F172A;&#39;&gt;current_health&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;Enum (HEALTHY, DOWN)&lt;/span&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b style=&#39;color: #0F172A;&#39;&gt;created_at&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;DateTime (default: now)&lt;/span&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b style=&#39;color: #0F172A;&#39;&gt;updated_at&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;DateTime (@updatedAt)&lt;/span&gt;&lt;/div&gt;" vertex="1">
