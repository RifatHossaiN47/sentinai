        <mxCell id="card_ai_contract" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;spacingRight=14;arcSize=8;shadow=1;" value="&lt;b style=&#39;font-size: 14.5px; color: #312E81;&#39;&gt;Gemini AI Diagnostic Contract &amp;amp; Fallback&lt;/b&gt;&lt;br/&gt;&lt;div style=&#39;font-size: 12px; color: #1E1B4B; line-height: 1.5; margin-top: 6px;&#39;&gt;• &lt;b&gt;Structured JSON Contract:&lt;/b&gt; Strict output schema guarantees type-safe UI parsing without hallucinated formatting.&lt;br/&gt;• &lt;b&gt;Circuit Breaker &amp;amp; Fallback:&lt;/b&gt; 3.5s timeout traps HTTP 429/503 errors and generates deterministic alert templates so monitoring never drops telemetry.&lt;/div&gt;" vertex="1">
          <mxGeometry height="185" width="430" x="920" y="630" as="geometry" />
        </mxCell>
        <mxCell id="entity_audit" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#047857;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;spacingRight=14;arcSize=6;shadow=1;" value="&lt;div style=&#39;border-bottom: 2px solid #047857; padding-bottom: 8px; margin-bottom: 10px;&#39;&gt;&lt;span style=&#39;font-size: 16px; font-weight: 800; color: #064E3B;&#39;&gt;AlertActionLog&lt;/span&gt; &amp;nbsp;&lt;span style=&#39;background-color: #ECFDF5; color: #065F46; font-size: 11.5px; padding: 2px 7px; border-radius: 4px; font-weight: bold;&#39;&gt;Audit &amp;amp; MTTR&lt;/span&gt;&lt;/div&gt;&lt;div style=&#39;font-family: Inter, sans-serif; font-size: 13px; line-height: 1.85;&#39;&gt;&lt;span style=&#39;background-color: #FEF3C7; color: #92400E; font-size: 11px; font-weight: 800; padding: 1px 5px; border-radius: 3px;&#39;&gt;PK&lt;/span&gt; &amp;nbsp;&lt;b style=&#39;color: #064E3B;&#39;&gt;id&lt;/b&gt; : &lt;span style=&#39;color: #065F46;&#39;&gt;String (UUID)&lt;/span&gt;&lt;br/&gt;&lt;span style=&#39;background-color: #FFEDD5; color: #C2410C; font-size: 11px; font-weight: 800; padding: 1px 5px; border-radius: 3px;&#39;&gt;FK&lt;/span&gt; &amp;nbsp;&lt;b style=&#39;color: #0F172A;&#39;&gt;alert_id&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;String (FK → AnomalyAlert)&lt;/span&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b style=&#39;color: #0F172A;&#39;&gt;action_type&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;String (&amp;quot;RESOLVED&amp;quot;, &amp;quot;ACK&amp;quot;)&lt;/span&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b style=&#39;color: #0F172A;&#39;&gt;operator_name&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;String (default: &amp;quot;SRE Admin&amp;quot;)&lt;/span&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b style=&#39;color: #0F172A;&#39;&gt;resolution_notes&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;Text? (Operator notes)&lt;/span&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b style=&#39;color: #0F172A;&#39;&gt;mttr_seconds&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;Int? (resolved - detected)&lt;/span&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b style=&#39;color: #0F172A;&#39;&gt;created_at&lt;/b&gt; : &lt;span style=&#39;color: #64748B;&#39;&gt;DateTime (default: now)&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="330" width="350" x="1430" y="128" as="geometry" />
