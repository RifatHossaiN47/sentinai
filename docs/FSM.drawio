        <mxCell id="lane_p1_critical" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=12;arcSize=8;shadow=1;" value="&lt;table style=&#39;width: 100%; border-collapse: collapse; font-family: Inter, sans-serif;&#39;&gt;&lt;tr&gt;&lt;td style=&#39;width: 25%; vertical-align: top; padding-right: 10px;&#39;&gt;&lt;span style=&#39;background-color: #DC2626; color: #FFFFFF; padding: 2px 8px; border-radius: 4px; font-weight: bold; font-size: 11px;&#39;&gt;P1 CRITICAL&lt;/span&gt;&lt;br/&gt;&lt;b style=&#39;font-size: 12px; color: #991B1B;&#39;&gt;Server Outage&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;width: 75%; vertical-align: top;&#39;&gt;&lt;b style=&#39;font-size: 11px; color: #7F1D1D;&#39;&gt;Condition:&lt;/b&gt; &lt;code style=&#39;background-color: #FEE2E2;&#39;&gt;status_code ≥ 500&lt;/code&gt; (500 Internal Error, 502 Bad Gateway, 503 Outage, 504 Timeout)&lt;br/&gt;&lt;b style=&#39;font-size: 11px; color: #7F1D1D;&#39;&gt;Action:&lt;/b&gt; Immediate Gemini AI Triage + &lt;b style=&#39;color: #DC2626;&#39;&gt;Automated Nodemailer Email Dispatch&lt;/b&gt; (Bonus 7.4)&lt;br/&gt;&lt;b style=&#39;font-size: 11px; color: #7F1D1D;&#39;&gt;SLA:&lt;/b&gt; Immediate Alert &amp;lt; 1 sec | MTTD Target: &amp;lt; 15 sec&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
